    <!-- JAVASCRIPT: عقل البوابة                        -->
    <!-- ============================================== -->
    <script>
        // ربط المتغيرات الأساسية بالنافذة لتكون متاحة للكود البرمجي الخاص بقواعد البيانات
        window.currentTab = 'robo'; 

        // 1. نظام التنقل بين الفواتير
        window.switchTab = function(tabId) {
            window.currentTab = tabId;
            
            // تحديث الأزرار العلوية
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.querySelector(`.tab-btn[onclick="window.switchTab('${tabId}')"]`) || document.querySelector(`.tab-btn[onclick="switchTab('${tabId}')"]`);
            if(activeBtn) activeBtn.classList.add('active');

            // إخفاء كل الفواتير وإظهار المطلوبة
            document.querySelectorAll('.invoice-wrapper').forEach(wrapper => wrapper.classList.remove('active'));
            document.getElementById('wrapper-' + tabId).classList.add('active');

            // إظهار/إخفاء أزرار Electra المخصصة للعلامة المائية والـ QR
            document.getElementById('btn-elec-wm').style.display = (tabId === 'elec') ? 'inline-block' : 'none';
            document.getElementById('btn-elec-qr').style.display = (tabId === 'elec') ? 'inline-block' : 'none';

            // تحديث كلاس body للطباعة 
            document.body.className = 'print-mode-' + tabId;

            window.calculateTotals();
        }

        // 2. نظام الحسابات الموحد 
        function formatMoney(num, format) {
            let str = num.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            if (format === 'robo') return num.toFixed(2).replace(/\.00$/, ''); 
            if (format === 'ram') return 'EGP ' + str; 
            if (format === 'elec') return str + 'EGP'; 
            return str;
        }

        window.calculateTotals = function() {
            const wrapper = document.getElementById('wrapper-' + window.currentTab);
            let subtotal = 0;
            const rows = wrapper.querySelectorAll('.item-row');

            rows.forEach(row => {
                const priceText = row.querySelector('.price-cell').innerText || "0";
                const qtyText = row.querySelector('.qty-cell').innerText || "0";
                
                const price = parseFloat(priceText.replace(/[^0-9.-]+/g,"")) || 0;
                const qty = parseFloat(qtyText.replace(/[^0-9.-]+/g,"")) || 0;
                
                const rowTotal = price * qty;
                row.querySelector('.row-total').innerText = formatMoney(rowTotal, window.currentTab);
                subtotal += rowTotal;
            });

            const subDisplay = wrapper.querySelector('.subtotal-val');
            if(subDisplay) subDisplay.innerText = formatMoney(subtotal, window.currentTab);

            let taxRate = 0;
            const taxCell = wrapper.querySelector('.tax-val'); 
            const taxLabel = wrapper.querySelector('.tax-val-label'); 
            
            if(window.currentTab === 'robo' && taxCell) {
                taxRate = parseFloat(taxCell.innerText.replace(/[^0-9.]/g, '')) || 0;
            } else if ((window.currentTab === 'ram' || window.currentTab === 'elec') && taxLabel) {
                taxRate = parseFloat(taxLabel.innerText.replace(/[^0-9.]/g, '')) || 0;
            }

            const taxAmount = subtotal * (taxRate / 100);
            
            const taxAmountDisplay = wrapper.querySelector('.tax-amount-val');
            if(taxAmountDisplay) taxAmountDisplay.innerText = formatMoney(taxAmount, window.currentTab);

            const grandTotal = subtotal + taxAmount;
            const grandDisplay = wrapper.querySelector('.grandtotal-val');
            if(grandDisplay) grandDisplay.innerText = formatMoney(grandTotal, window.currentTab);
        }

        document.body.addEventListener('input', function(e) {
            if (e.target.classList.contains('price-cell') || 
                e.target.classList.contains('qty-cell') || 
                e.target.classList.contains('tax-val') ||
                e.target.classList.contains('tax-val-label')) {
                window.calculateTotals();
            }
        });

        // 3. نظام إضافة الصفوف 
        window.addRow = function() {
            const tbody = document.getElementById(window.currentTab + '-body');
            const newRow = document.createElement('tr');
            newRow.className = 'item-row';

            if (window.currentTab === 'robo') {
                newRow.innerHTML = `<td class="action-cell no-print"><button class="btn-delete" onclick="window.deleteRow(this)">X</button></td><td class="total-col row-total">0</td><td class="price-cell" contenteditable="true">0</td><td class="qty-cell" contenteditable="true">1</td><td class="desc-cell" contenteditable="true">وصف الأداة...</td>`;
            } else if (window.currentTab === 'ram') {
                newRow.innerHTML = `<td class="action-cell no-print"><button class="btn-delete" onclick="window.deleteRow(this)">X</button></td><td class="desc-cell" contenteditable="true">Item Name</td><td class="qty-cell" contenteditable="true">1</td><td class="price-cell" contenteditable="true">0.00</td><td class="tax-cell tax-val" contenteditable="true">14%</td><td class="total-col row-total">EGP 0.00</td>`;
            } else if (window.currentTab === 'elec') {
                newRow.innerHTML = `<td class="total-col row-total">0.00EGP</td><td class="price-cell" contenteditable="true">0.00</td><td class="qty-cell" contenteditable="true">1.00Units</td><td class="desc-cell" contenteditable="true">Item Description</td><td class="action-cell no-print"><button class="btn-delete" onclick="window.deleteRow(this)">X</button></td>`;
            }
            tbody.appendChild(newRow);
            window.calculateTotals();
        }

        window.deleteRow = function(btn) {
            btn.closest('tr').remove();
            window.calculateTotals();
        }

        // 4. نظام رفع ملفات Excel 
        window.handleExcelUpload = function(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, {type: 'array'});
                const json = XLSX.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]], {header: 1});

                if (json.length > 0) {
                    const tbody = document.getElementById(window.currentTab + '-body');
                    for (let i = 1; i < json.length; i++) {
                        let row = json[i];
                        if (!row || row.length === 0) continue;
                        let desc = row[0] || ''; let qty = row[1] || 1; let price = row[2] || 0;

                        if(desc.toString().trim() !== '') {
                            const newRow = document.createElement('tr');
                            newRow.className = 'item-row';
                            if (window.currentTab === 'robo') {
                                newRow.innerHTML = `<td class="action-cell no-print"><button class="btn-delete" onclick="window.deleteRow(this)">X</button></td><td class="total-col row-total">0</td><td class="price-cell" contenteditable="true">${price}</td><td class="qty-cell" contenteditable="true">${qty}</td><td class="desc-cell" contenteditable="true">${desc}</td>`;
                            } else if (window.currentTab === 'ram') {
                                newRow.innerHTML = `<td class="action-cell no-print"><button class="btn-delete" onclick="window.deleteRow(this)">X</button></td><td class="desc-cell" contenteditable="true">${desc}</td><td class="qty-cell" contenteditable="true">${qty}</td><td class="price-cell" contenteditable="true">${price}</td><td class="tax-cell tax-val" contenteditable="true">14%</td><td class="total-col row-total">0</td>`;
                            } else if (window.currentTab === 'elec') {
                                newRow.innerHTML = `<td class="total-col row-total">0</td><td class="price-cell" contenteditable="true">${price}</td><td class="qty-cell" contenteditable="true">${qty}Units</td><td class="desc-cell" contenteditable="true">${desc}</td><td class="action-cell no-print"><button class="btn-delete" onclick="window.deleteRow(this)">X</button></td>`;
                            }
                            tbody.appendChild(newRow);
                        }
                    }
                    window.calculateTotals();
                }
            };
            reader.readAsArrayBuffer(file);
            event.target.value = '';
        }

        // 5. نظام رفع الصور 
        window.handleImageUpload = function(event, type) {
            const file = event.target.files[0];
            if(!file) return;
            const url = URL.createObjectURL(file);
            const wrapper = document.getElementById('wrapper-' + window.currentTab);

            if(type === 'logo') {
                const img = wrapper.querySelector('.target-logo');
                if(img) { img.src = url; img.style.background = 'transparent'; img.style.display = 'block'; }
            } else if (type === 'watermark' && window.currentTab === 'elec') {
                const img = wrapper.querySelector('.target-wm');
                if(img) { img.src = url; img.style.display = 'inline-block'; }
            } else if (type === 'qr' && window.currentTab === 'elec') {
                const img = wrapper.querySelector('.target-qr');
                if(img) { img.src = url; img.style.display = 'inline-block'; }
            }
        }

        // 6. نظام التصدير
        window.exportToWord = function() {
            const wrapper = document.getElementById('wrapper-' + window.currentTab);
            const actionCols = wrapper.querySelectorAll('.action-col, .action-cell');
            actionCols.forEach(col => col.style.display = 'none');
            
            const content = wrapper.innerHTML;
            actionCols.forEach(col => col.style.display = 'table-cell');

            const preHtml = `<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Invoice</title><style>body { font-family: 'Cairo', Arial, sans-serif; direction: rtl; } table { border-collapse: collapse; width: 100%; direction: ltr; } th, td { padding: 8px; border-bottom: 1px solid #ccc; text-align: center; } .desc-cell { text-align: left; } .total-col { font-weight: bold; } .totals-table { width: 350px; } .totals-table td { border: none; } .totals-label { text-align: center; font-weight: bold; }</style></head><body>`;
            const postHtml = "</body></html>";
            const html = preHtml + content + postHtml;

            const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
            const url = 'data:application/vnd.ms-word;charset=utf-8,' + encodeURIComponent(html);
            const downloadLink = document.createElement("a");
            
            document.body.appendChild(downloadLink);
            if (navigator.msSaveOrOpenBlob) {
                navigator.msSaveOrOpenBlob(blob, 'Invoice.doc');
            } else {
                downloadLink.href = url;
                downloadLink.download = 'Invoice_' + window.currentTab + '.doc';
                downloadLink.click();
            }
            document.body.removeChild(downloadLink);
        }

        window.saveAsPDF = function() {
            if(window.currentTab === 'elec') {
                window.showToast("تأكد من تفعيل خيار 'Background graphics' في إعدادات الطباعة.", false);
            } else {
                window.showToast("تأكد من إلغاء خيار 'Headers and footers' في إعدادات الطباعة.", false);
            }
            setTimeout(() => window.print(), 1000);
        }

        // تشغيل الحسابات لأول مرة 
        window.calculateTotals();
    </script>

    <!-- ============================================== -->
    <!-- FIREBASE INTEGRATION                           -->
    <!-- ============================================== -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, getDocs, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // إعدادات Firebase من المستخدم
        const firebaseConfig = {
            apiKey: "AIzaSyDFjd-HIl3GVAAnhPUgxcVw2J3TtOligQk",
            authDomain: "invoice-70f41.firebaseapp.com",
            projectId: "invoice-70f41",
            storageBucket: "invoice-70f41.firebasestorage.app",
            messagingSenderId: "164862087942",
            appId: "1:164862087942:web:56884a96b429e88ab38487",
            measurementId: "G-MBTXMJK2Q6"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // متغيرات البيئة العامة المطلوبة للبنية الهيكلية
        const defaultAppId = typeof __app_id !== 'undefined' ? __app_id : 'invoice-v1';
        let currentUser = null;

        // دالة لعرض رسائل التنبيه (Toast)
        window.showToast = (msg, isError = false) => {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.style.backgroundColor = isError ? '#e74c3c' : '#2ecc71';
            toast.className = 'toast show';
            setTimeout(() => { toast.className = toast.className.replace("show", ""); }, 3000);
        }

        // المصادقة والاتصال بقاعدة البيانات بشكل آمن
        const initAuth = async () => {
            try {
                // التحقق من وجود توكن مصادقة مسبق
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    const userCredential = await signInWithCustomToken(auth, __initial_auth_token);
                    currentUser = userCredential.user;
                } else {
                    // تسجيل دخول كزائر مجهول (Anonymous)
                    const userCredential = await signInAnonymously(auth);
                    currentUser = userCredential.user;
                }
                console.log("متصل بقاعدة البيانات بنجاح. المعرف:", currentUser.uid);
                
                // تحميل إعدادات الصور المحفوظة إن وجدت بمجرد تسجيل الدخول
                window.loadImageSettings();
                
            } catch (error) {
                console.error("خطأ في الاتصال بقاعدة البيانات:", error);
                currentUser = { uid: "local-test-user-id" }; 
                
                if (error.code === 'auth/operation-not-allowed') {
                    window.showToast("تنبيه: يجب تفعيل 'Anonymous' من قائمة Authentication في Firebase.", true);
                } else {
                    window.showToast("تعذر الاتصال بالمصادقة. سيتم المحاولة في وضع التجربة.", true);
                }
            }
        };

        // بدء الاتصال
        initAuth();

        // دوال التحكم بالنافذة المنبثقة
        window.openSaveModal = () => {
            if(!currentUser) return window.showToast("جاري الاتصال بقاعدة البيانات... يرجى الانتظار قليلاً.", true);
            document.getElementById('save-modal-overlay').style.display = 'flex';
        };

        window.closeSaveModal = () => {
            document.getElementById('save-modal-overlay').style.display = 'none';
            document.getElementById('invoice-name-input').value = '';
        };

        // دوال نافذة الإعدادات للصور
        window.openSettingsModal = () => {
            if(!currentUser) return window.showToast("يجب الاتصال بقاعدة البيانات أولاً.", true);
            document.getElementById('settings-modal-overlay').style.display = 'flex';
        };

        window.closeSettingsModal = () => {
            document.getElementById('settings-modal-overlay').style.display = 'none';
        };

        window.saveImageSettings = async () => {
            if (!currentUser) return;
            const settings = {
                roboLogo: document.getElementById('robo-logo-url').value.trim(),
                ramLogo: document.getElementById('ram-logo-url').value.trim(),
                elecLogo: document.getElementById('elec-logo-url').value.trim(),
                elecWm: document.getElementById('elec-wm-url').value.trim(),
                elecQr: document.getElementById('elec-qr-url').value.trim()
            };
            
            try {
                window.showToast("جاري حفظ الإعدادات...");
                const docRef = doc(db, 'artifacts', defaultAppId, 'users', currentUser.uid, 'settings', 'images');
                await setDoc(docRef, settings, { merge: true });
                window.showToast("تم حفظ الروابط الافتراضية بنجاح!");
                window.closeSettingsModal();
                
                // تطبيق الصور فوراً على الواجهة
                window.loadImageSettings();
            } catch (error) {
                console.error("Error saving settings: ", error);
                window.showToast("حدث خطأ أثناء حفظ الإعدادات", true);
            }
        };

        window.loadImageSettings = async () => {
            if (!currentUser) return;
            try {
                const docRef = doc(db, 'artifacts', defaultAppId, 'users', currentUser.uid, 'settings', 'images');
                const docSnap = await getDoc(docRef);
                if (docSnap.exists()) {
                    const data = docSnap.data();
                    
                    const setImg = (id, url, isLogo) => {
                        if (url) {
                            const img = document.getElementById(id);
                            img.src = url;
                            img.style.display = isLogo ? 'block' : 'inline-block';
                            if(isLogo) img.style.background = 'transparent';
                        }
                    };

                    setImg('robo-logo', data.roboLogo, true);
                    setImg('ram-logo', data.ramLogo, true);
                    setImg('elec-logo', data.elecLogo, true);
                    setImg('elec-wm', data.elecWm, false);
                    setImg('elec-qr', data.elecQr, false);
                    
                    document.getElementById('robo-logo-url').value = data.roboLogo || '';
                    document.getElementById('ram-logo-url').value = data.ramLogo || '';
                    document.getElementById('elec-logo-url').value = data.elecLogo || '';
                    document.getElementById('elec-wm-url').value = data.elecWm || '';
                    document.getElementById('elec-qr-url').value = data.elecQr || '';
                }
            } catch (error) {
                console.error("Error loading settings: ", error);
            }
        };

        // دالة حفظ الفاتورة الحالية في Firebase
        window.confirmSaveInvoice = async () => {
            const nameInput = document.getElementById('invoice-name-input');
            const name = nameInput.value.trim();
            if(!name) return window.showToast("رجاءً قم بإدخال اسم أو مرجع للفاتورة", true);

            // جلب محتوى الفاتورة الحالي بالكامل 
            const activeWrapper = document.getElementById('wrapper-' + window.currentTab);
            const containerHtml = activeWrapper.querySelector('.document-container').innerHTML;

            const invoiceData = {
                name: name,
                tabId: window.currentTab,
                htmlContent: containerHtml,
                timestamp: Date.now()
            };

            try {
                window.showToast("جاري الحفظ...");
                const colRef = collection(db, 'artifacts', defaultAppId, 'users', currentUser.uid, 'invoices');
                await addDoc(colRef, invoiceData);
                
                window.showToast("تم حفظ الفاتورة بنجاح في قاعدة البيانات!");
                window.closeSaveModal();
            } catch (error) {
                console.error("Error saving document: ", error);
                window.showToast("حدث خطأ أثناء حفظ الفاتورة.", true);
            }
        };

        // دالة فتح/إغلاق القائمة الجانبية وجلب الفواتير المحفوظة
        window.toggleSidebar = async () => {
            const sidebar = document.getElementById('sidebar');
            if (sidebar.classList.contains('open')) {
                sidebar.classList.remove('open');
                return;
            }

            if(!currentUser) return window.showToast("جاري الاتصال بقاعدة البيانات... يرجى الانتظار.", true);

            sidebar.classList.add('open');
            const list = document.getElementById('invoice-list');
            list.innerHTML = '<li style="text-align:center; background:transparent; border:none;">جاري جلب الفواتير...</li>';

            try {
                const colRef = collection(db, 'artifacts', defaultAppId, 'users', currentUser.uid, 'invoices');
                const snapshot = await getDocs(colRef);
                
                const invoices = [];
                snapshot.forEach(doc => {
                    invoices.push({ id: doc.id, ...doc.data() });
                });

                // ترتيب الفواتير من الأحدث للأقدم
                invoices.sort((a, b) => b.timestamp - a.timestamp);

                list.innerHTML = '';
                if(invoices.length === 0) {
                    list.innerHTML = '<li style="text-align:center; background:transparent; border:none; color:#bdc3c7;">لا توجد فواتير محفوظة بعد.</li>';
                } else {
                    invoices.forEach(inv => {
                        const li = document.createElement('li');
                        const date = new Date(inv.timestamp).toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                        
                        let typeName = "الأنظمة المدمجة";
                        if(inv.tabId === 'ram') typeName = "RAM Electronics";
                        if(inv.tabId === 'elec') typeName = "Electra Group";

                        li.innerHTML = `
                            <span class="inv-name">${inv.name}</span>
                            <span class="inv-type">${typeName}</span>
                            <span class="inv-date">${date}</span>
                        `;
                        
                        // عند الضغط على الفاتورة يتم عرضها
                        li.onclick = () => loadSavedInvoice(inv);
                        list.appendChild(li);
                    });
                }

            } catch (error) {
                console.error("Error getting documents: ", error);
                list.innerHTML = '<li style="text-align:center; background:transparent; border:none; color:#e74c3c;">حدث خطأ في تحميل الفواتير.</li>';
            }
        };

        // دالة استرجاع الفاتورة وعرضها
        window.loadSavedInvoice = function(invData) {
            window.switchTab(invData.tabId);
            
            const activeWrapper = document.getElementById('wrapper-' + invData.tabId);
            const container = activeWrapper.querySelector('.document-container');
            container.innerHTML = invData.htmlContent;
            
            window.calculateTotals();
            window.showToast(`تم استرجاع الفاتورة: ${invData.name}`);
            window.toggleSidebar(); // إغلاق القائمة الجانبية بعد التحميل
        }

    </script>
</body>
</html>
